[flake8]
max-line-length = 79
max-doc-length = 72
extend-ignore = E203,W503
exclude =
    .git,
    __pycache__,
    */migrations/*,
    manage.py,
    venv,
    env,
    .venv,
    */staticfiles/*,
    */static/*,
    */media/*,
    */mediafiles/*,
    */logs/*,
    build,
    dist,
    *.egg-info
per-file-ignores =
    __init__.py:F401
